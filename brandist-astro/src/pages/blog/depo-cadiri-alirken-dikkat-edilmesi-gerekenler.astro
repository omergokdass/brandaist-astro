>
    <script type="application/ld+json" is:inline>
        {
            "@context": "https://schema.org",
            "@type": "BlogPosting",
            "headline": "Depo Çadırı Alırken Dikkat Edilmesi Gereken 5 Önemli Unsur",
            "author": {
                "@type": "Organization",
                "name": "Amir Branda"
            },
            "publisher": {
                "@type": "Organization",
                "name": "Amir Branda",
                "logo": {
                    "@type": "ImageObject",
                    "url": "https://www.branda.ist/style/brand/img/branda-logo.webp"
                }
